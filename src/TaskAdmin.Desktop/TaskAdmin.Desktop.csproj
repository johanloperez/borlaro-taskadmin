<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (icono de bandeja y globo nativo de Windows) vive en WinForms. Es la vía
         soportada para tener presencia en la bandeja desde WPF sin dependencias de terceros. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TaskAdmin</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <!-- Sin WebView2: el chat se dibuja nativo contra la API. Embeber la aplicación web traía su
         router y su guardia de sesión adentro de esta ventana, y una persona ya autenticada en la
         app terminaba viendo una segunda pantalla de login. Además obligaba a instalar el runtime
         de Edge en cada máquina para algo que son cuatro llamadas HTTP. -->
  </ItemGroup>

</Project>
