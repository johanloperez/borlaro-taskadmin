# Copiar a .env y completar. .env está en .gitignore — nunca lo subas.

# Clave de firma de los JWT. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
JWT_SIGNING_KEY=

# Contraseña de Postgres. Cambiala antes de exponer nada.
POSTGRES_PASSWORD=taskadmin

# Clave de la API de Anthropic para el agente de check-ins.
# También se puede cargar después desde la pantalla de Configuración, que la guarda cifrada.
ANTHROPIC_API_KEY=

# Qué modelo atiende los check-ins: «anthropic» (la API) u «openai-compatible» (un modelo que
# corre en tu máquina, vía Ollama, LM Studio o vLLM). Las nueve herramientas son las mismas.
#
# Para un modelo local con Ollama en el host:
#   AGENT_PROVIDER=openai-compatible
#   AGENT_MODEL=qwen3-taskadmin
#   AGENT_BASE_URL=http://host.docker.internal:11434/v1
#
# «host.docker.internal» y no «localhost»: la API corre en un contenedor, y ahí localhost es el
# contenedor mismo, no la máquina donde escucha Ollama.
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5
AGENT_BASE_URL=

# Material para cifrar los secretos que se cargan desde Configuración (SMTP, clave del modelo).
# Si queda vacío se usa JWT_SIGNING_KEY, y entonces rotar esa clave vuelve ilegibles los secretos.
# Generar con: openssl rand -base64 48
SECRETS_KEY=

# Dominio para el TLS automático de Caddy. En local, dejalo en localhost.
TASKADMIN_DOMAIN=localhost

# Base pública para los enlaces de los emails y para CORS.
# En un servidor real: https://tu-dominio
PUBLIC_BASE_URL=http://localhost

# Primer administrador. Solo se crea si la base no tiene ningún usuario; después se ignora.
# Sin esto la instancia arranca y queda inaccesible: no hay admin/admin de fábrica a propósito.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORGANIZATION_NAME=Mi organización

# ── De cuántas empresas es esta instalación ───────────────────────────────────
# Single: una sola empresa, sin registro ni consola de plataforma. Es el modo on-premise y el
#   que reproduce el comportamiento anterior a las organizaciones.
# Multi: varias empresas sobre el mismo despliegue, aisladas entre sí.
TENANCY_MODE=Single

# Si cualquiera puede abrir su organización entrando con el proveedor de identidad. Con esto en
# false las organizaciones las crea el operador desde su consola. Solo aplica en modo Multi.
TENANCY_ALLOW_REGISTRATION=true

# Dominios que pueden registrarse, separados por coma. Vacío = cualquiera. Es la diferencia entre
# publicar la instalación para un grupo conocido y publicarla para internet.
TENANCY_ALLOWED_DOMAINS=

# Quien opera la instalación: da de alta organizaciones, las suspende y las reactiva. No es admin
# de ninguna y no ve el contenido de ninguna. Solo se crea en modo Multi.
PLATFORM_OPERATOR_EMAIL=
PLATFORM_OPERATOR_PASSWORD=

ASPNETCORE_ENVIRONMENT=Production
